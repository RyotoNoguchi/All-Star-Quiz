{
  "name": "all-star-quiz-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build && npm run realtime:build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:transport": "node scripts/check-realtime.mjs",
    "check": "npm run lint && npm run format:check && npm run test:run && npm run test:db && npm run test:transport && npm run type-check && npm run build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test:db": "node scripts/test-db.mjs",
    "postinstall": "prisma generate",
    "admin:create": "tsx scripts/create-admin.ts",
    "realtime:build": "esbuild src/server/realtime-entry.ts --bundle --platform=node --packages=external --outfile=.realtime/server.cjs",
    "realtime:start": "node .realtime/server.cjs",
    "realtime:dev": "tsx src/server/realtime-entry.ts",
    "test:e2e": "node scripts/test-e2e.mjs",
    "deployment:check": "tsx scripts/validate-deployment.ts",
    "security:check": "npm audit --audit-level=moderate",
    "db:backup": "node scripts/backup-database.mjs",
    "test:backup": "node scripts/test-backup.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.525.0",
    "next": "15.5.25",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "redis": "^5.12.1",
    "sharp": "0.35.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.2",
    "prisma": "6.19.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "eslint-config-prettier": "^10.1.5",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "postcss": "8.5.28",
    "picomatch@^2.3.1": "2.3.2"
  }
}
