generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum GamePhase {
  waiting
  playing
  closing
  results
  finished
}

enum QuestionType {
  normal
  final
}

enum Choice {
  A
  B
  C
  D
}

model User {
  id           String         @id @default(uuid())
  tokenHash    String?        @unique
  createdAt    DateTime       @default(now())
  participants Participant[]
  sessions     GuestSession[]
}

model Game {
  id                   String         @id @default(uuid())
  code                 String         @unique
  phase                GamePhase      @default(waiting)
  version              Int            @default(0)
  createdAt            DateTime       @default(now())
  expiresAt            DateTime
  finishReason         String?
  currentQuestionIndex Int            @default(-1)
  startedAt            DateTime?
  deadlineAt           DateTime?
  events               GameEventRecord[]
  submissions          AnswerSubmission[]
  commands             GameCommand[]
  participants         Participant[]
  questions            GameQuestion[]
  answers              Answer[]
  result               GameResult?
}

model Participant {
  id                String    @id @default(uuid())
  gameId            String
  userId            String
  name              String
  isHost            Boolean   @default(false)
  isEliminated      Boolean   @default(false)
  eliminationReason String?
  eliminatedAtQuestion Int?
  leftAt            DateTime?
  joinedOrder       Int       @default(autoincrement())
  game              Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id])
  disconnectedAt    DateTime?
  connections       RealtimeConnection[]
  answers           Answer[]

  @@unique([gameId, userId])
  @@unique([gameId, name])
  @@index([gameId, joinedOrder])
}

model Question {
  version Int @default(0)
  archivedAt DateTime?
  choiceImages Json @default("{}")
  id          String         @id @default(uuid())
  question    String
  choices     Json
  answer      Choice
  type        QuestionType   @default(normal)
  timeLimit   Int            @default(10)
  category    String?
  explanation String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  games       GameQuestion[]
}

model GameQuestion {
  id         String   @id @default(uuid())
  gameId     String
  questionId String
  position   Int
  snapshot   Json
  result     Json?
  resolvedAt DateTime?
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id])
  answers    Answer[]

  @@unique([gameId, position])
  @@unique([gameId, questionId])
}

model Answer {
  id                 String       @id @default(uuid())
  gameId             String
  gameQuestionId     String
  participantId      String
  requestId          String
  choice             Choice
  receivedAt         DateTime
  responseTime       Int
  acceptanceSequence Int
  isCorrect          Boolean
  game               Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameQuestion       GameQuestion @relation(fields: [gameQuestionId], references: [id], onDelete: Cascade)
  participant        Participant  @relation(fields: [participantId], references: [id])

  @@unique([gameQuestionId, participantId])
  @@unique([gameQuestionId, participantId, requestId])
  @@unique([gameId, acceptanceSequence])
}

model GameResult {
  totalQuestions Int @default(0)
  id          String   @id @default(uuid())
  gameId      String   @unique
  reason      String
  winnerId    String?
  ranking     Json
  statistics  Json
  completedAt DateTime @default(now())
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model GuestSession {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Admin {
  id             String         @id @default(uuid())
  email          String         @unique
  passwordHash   String
  enabled        Boolean        @default(true)
  failedAttempts Int            @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime       @default(now())
  sessions       AdminSession[]
}

model AdminSession {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  adminId   String
  expiresAt DateTime
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model GameCommand {
  id String @id @default(uuid())
  gameId String
  requestId String
  userId String
  action String
  expectedVersion Int
  response Json
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  @@unique([gameId, requestId])
}

model RealtimeConnection {
  id String @id
  participantId String
  expiresAt DateTime
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  @@index([participantId, expiresAt])
  @@index([expiresAt])
}

model AnswerSubmission {
  id String @id @default(uuid())
  gameId String
  userId String
  questionId String
  requestId String
  choice Choice
  receivedAt DateTime @default(dbgenerated("date_trunc('milliseconds', clock_timestamp() AT TIME ZONE 'UTC')"))
  acceptanceSequence Int @default(autoincrement())
  processedAt DateTime?
  errorCode String?
  receipt Json?
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  @@unique([gameId, userId, questionId, requestId])
  @@index([gameId, processedAt, acceptanceSequence])
}

model GameEventRecord {
  id String @id @default(uuid())
  gameId String
  version Int
  type String
  payload Json
  createdAt DateTime @default(now())
  publishedAt DateTime?
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  @@unique([gameId, version])
  @@index([publishedAt, createdAt])
}
